# BD++ Backend — environment variables. Copy to .env and fill in.
DATABASE_URL=sqlite+aiosqlite:///./bdpp.db
# For prod: postgresql+asyncpg://user:pass@host:5432/bdpp

REDIS_URL=redis://localhost:6379/0

# Outscraper (optional — used by Indeed fallback / Contacts & Leads)
OUTSCRAPER_TOKEN=

# MillionVerifier (required for email verification)
MILLIONVERIFIER_TOKEN=

# Apollo (optional — fallback contact resolver)
APOLLO_API_KEY=

# Google Cloud (optional — Custom Search Engine for contact search)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Anthropic (optional — powers Intel toggles)
ANTHROPIC_API_KEY=

# Default budget cap per enrich job
DEFAULT_MAX_SPEND_USD=6.0
