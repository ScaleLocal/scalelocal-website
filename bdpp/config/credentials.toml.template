# BD++ Credentials Template
# Copy this file to credentials.toml and fill in your own keys.
# DO NOT commit credentials.toml to version control.

[google]
# Google Cloud API key — needs Places API (New), Geocoding, Custom Search
# Get one at: https://console.cloud.google.com/apis/credentials
api_key = ""

# Google Custom Search Engine ID — only needed if you want the Google Jobs / web fallback
# Create one at: https://programmablesearchengine.google.com/
cse_id = ""

[outscraper]
# Outscraper API token — used for Maps, Domain Emails, Contacts & Leads
# Get one at: https://outscraper.com/profile/
api_token = ""

[millionverifier]
# MillionVerifier API token — used for email deliverability checks
# Get one at: https://app.millionverifier.com/api
api_token = ""

[anthropic]
# Anthropic API key — used for the three Intel toggles (skill extraction etc.)
# Optional; if blank the intel toggles will be disabled
# Get one at: https://console.anthropic.com/settings/keys
api_key = ""

[budget]
# Hard cap per search run, in USD. The pipeline will stop spending when this is hit.
default_max_spend_usd = 6.0
