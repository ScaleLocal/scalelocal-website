dow:0 6px 18px rgba(8,14,26,.08)}\n  .industry-card h3{font-family:'Montserrat',sans-serif;font-weight:700;color:var(--dark,#1a2e4a);font-size:1.02rem;margin-bottom:6px}\n  .industry-card p{font-size:0.88rem;color:var(--muted,#6b7a8d);line-height:1.55;margin-bottom:10px}\n  .industry-card-link{font-family:'Montserrat',sans-serif;font-weight:700;font-size:0.82rem;color:var(--brand,#2E75B6)}\n  .industry-links-grid{display:flex;flex-wrap:wrap;gap:8px}\n  .industry-links-grid a{display:inline-block;padding:6px 14px;background:var(--mist,#f5f8fb);border:1px solid var(--line,#e2e8f0);border-radius:6px;font-size:0.8rem;color:var(--brand,#2E75B6);text-decoration:none}\n  .cta-section{background:var(--dark,#1a2e4a);border-radius:14px;padding:40px 32px;margin:48px 0 0;text-align:center}\n  .cta-section h2{color:#fff;font-family:'Montserrat',sans-serif;font-weight:700;margin:0 0 12px}\n  .cta-section p{color:rgba(255,255,255,.78);max-width:54ch;margin:0 auto 22px}\n  a:focus-visible,button:focus-visible{outline:3px solid var(--brand,#2E75B6);outline-offset:2px}\n  </style>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@graph\": [\n      {\n        \"@type\": \"BlogPosting\",\n        \"headline\": \"How Many Google Reviews Does a Contractor Need to Rank?\",\n        \"description\": \"What the 2026 data actually says about how many Google reviews a contractor needs to rank in the map pack — and why recency beats the raw number.\",\n        \"author\": { \"@type\": \"Organization\", \"name\": \"ScaleLocal\", \"url\": \"https://www.scalelocal.net/\" },\n        \"publisher\": {\n          \"@type\": \"Organization\",\n          \"name\": \"ScaleLocal\",\n          \"url\": \"https://www.scalelocal.net/\",\n          \"logo\": { \"@type\": \"ImageObject\", \"url\": \"https://www.scalelocal.net/og-image.png\" }\n        },\n        \"datePublished\": \"2026-06-19\",\n        \"mainEntityOfPage\": { \"@type\": \"WebPage\", \"@id\": \"https://www.scalelocal.net/blog/how-many-google-reviews-does-a-contractor-need/\" }\n      },\n      {\n        \"@type\": \"BreadcrumbList\",\n        \"itemListElement\": [\n          { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://www.scalelocal.net/\" },\n          { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Blog\", \"item\": \"https://www.scalelocal.net/blog/\" },\n          { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"How Many Reviews You Need\", \"item\": \"https://www.scalelocal.net/blog/how-many-google-reviews-does-a-contractor-need/\" }\n        ]\n      }\n    ]\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How many Google reviews do I need to rank in the map pack?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"There’s no exact threshold, but top-three local results average around 47 reviews while positions 7–10 average about 38. Aim to clear roughly 50 to compete and 100+ to be hard to displace — paired with a steady, recent flow rather than a one-time push.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do older Google reviews still count?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"They count, but far less than recent ones. Google weights fresh reviews more heavily because they signal an active, currently-trusted business. A steady stream of new reviews typically outperforms a larger but stale review base.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do I get more Google reviews as a contractor?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Use a system, not memory. Send an automated text or email with a direct review link after every completed job, prompt customers to mention the specific work and town, and respond to every review. Automated requests dramatically out-perform asking manually, which always fades over time.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Does my star rating matter as much as the number of reviews?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Both matter. Volume and recency drive ranking, while your rating and the content of reviews drive whether searchers actually choose you — 97% read reviews before picking a local business. A high count with a mediocre rating still loses jobs to a better-rated competitor.\"\n      }\n    }\n  ]\n}\n  </script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#main\">Skip to main content</a>\n<header class=\"sl-header\" style=\"position:relative;\">\n  <input type=\"checkbox\" id=\"slMenu\" class=\"sl-menu-toggle\" aria-hidden=\"true\">\n  <div class=\"wrap\">\n    <a href=\"/\" class=\"sl-logo\"><span class=\"lg-scale\">Scale</span><span class=\"lg-local\">Local</span><sup>&trade;</sup></a>\n    <nav class=\"sl-nav\">\n      <a href=\"/about/\">About</a>\n      <a href=\"/web-solutions/\">Web Solutions</a>\n      <a href=\"/ai-solutions/\">AI Solutions</a>\n      <a href=\"/pricing/\">Pricing</a>\n      <a href=\"/demos/\">Demos</a>\n      <a href=\"/get-started/\">Get Started</a>\n    </nav>\n    <a href=\"tel:+19786627580\" class=\"header-phone\">978.662.7580</a>\n      <label for=\"slMenu\" class=\"sl-burger\" aria-label=\"Open menu\"><span></span></label>\n  </div>\n    <div class=\"sl-mobile-menu\">\n      <nav aria-label=\"Mobile\">\n        <a href=\"/about/\">About</a>\n        <a href=\"/web-solutions/\">Web Solutions</a>\n        <a href=\"/ai-solutions/\">AI Solutions</a>\n        <a href=\"/pricing/\">Pricing</a>\n        <a href=\"/demos/\">Demos</a>\n        <a href=\"/get-started/\">Get Started</a>\n        <a class=\"mm-call\" href=\"tel:+19786627580\">Call 978.662.7580</a>\n      </nav>\n    </div>\n</header>\n<main id=\"main\">\n<article class=\"article\">\n    <p class=\"article-eyebrow\">ScaleLocal Blog</p>\n    <h1>How many Google reviews does a contractor need?</h1>\n    <p class=\"article-meta\">7 min read</p>\n    <p class=\"key-summary\" style=\"background:var(--mist,#f5f8fb);border-left:4px solid var(--brand,#2E75B6);padding:16px 22px;border-radius:0 8px 8px 0;font-size:1rem;line-height:1.7;color:var(--dark,#1a2e4a)\"><strong>There’s no magic number, but the data points to a clear target: top-three map-pack contractors average around 47 reviews, and businesses with 100+ tend to dominate. More important than hitting a number is a steady, recent flow — reviews are about 20% of local ranking and the first thing 97% of customers check.</strong></p>\n    <p>“How many reviews do I actually need?” is the right question with a frustrating answer: there’s no fixed threshold that flips you to the top. But the 2026 data gives you a real target to aim at — and reveals that <em>how</em> you get reviews matters as much as how many.</p>\n\n    <h2>What the numbers say</h2>\n    <p>Reviews have become one of the most powerful local ranking signals — their weight in Google’s local algorithm climbed from <strong>16% in 2023 to about 20% today</strong>. And the ranking correlation is concrete:</p>\n    <ul>\n      <li>Businesses in the <strong>top three</strong> local positions average <strong>47 reviews</strong>.</li>\n      <li>Those ranked <strong>7–10</strong> average about <strong>38</strong>.</li>\n      <li>Businesses with <strong>112+ reviews</strong> perform significantly better in local rankings.</li>\n    </ul>\n    <p>So a working target: <strong>get past ~50 to compete for the map pack, and aim for 100+ to make yourself hard to displace.</strong> But the count is only half the story.</p>\n\n    <h2>Why recency beats the raw number</h2>\n    <p>Fifty reviews from three years ago signal a business that <em>used</em> to be active. Google — and customers — weight recent reviews far more heavily. A steady drip of fresh reviews tells the algorithm you’re busy and trusted right now. This is why a contractor with 60 reviews and three new ones a week often outranks one with 120 reviews and none since last year.</p>\n\n    <h2>Why this matters beyond ranking</h2>\n    <p>Reviews don’t just rank you — they <strong>convert</strong> the people who find you. <strong>97% of consumers read reviews</strong> before choosing a local business, <strong>87% read them specifically for local businesses</strong>, and <strong>79% trust online reviews as much as a personal recommendation</strong>. You can rank first and still lose the job if your rating or review content is weak next to the contractor below you.</p>\n\n    <h2>How to actually get there</h2>\n    <h3>Ask every customer, every time — automatically</h3>\n    <p>The contractors who win at reviews aren’t lucky; they have a <a href=\"/blog/how-to-get-more-google-reviews-local-business/\">system</a>. A simple automated text after each completed job (“Thanks for choosing us — would you mind leaving a quick Google review? Here’s the link”) turns a forgotten afterthought into a reliable stream. Manual asking always fades; automation doesn’t.</p>\n    <h3>Make the review specific</h3>\n    <p>Reviews that mention the actual work (“replaced our roof in a day, fair price, cleaned up perfectly”) help both ranking and AI-search recommendations far more than a bare five stars. Prompting customers to mention the service and town quietly strengthens your local relevance.</p>\n    <h3>Respond to every one</h3>\n    <p>Responding to reviews — good and bad — is itself a ranking and trust signal. A calm, professional reply to a critical review often impresses prospects more than a wall of perfect fives.</p>\n\n    <blockquote><p>Want to see how your review count and rating stack up against the contractors ranking above you? <a href=\"/get-started/\">Run a free Digital Audit</a> — it shows your reviews next to your local competitors’ and where the gap is.</p></blockquote>\n    <div class=\"cta-box\">\n      <h3>Want to see where your business stands?</h3>\n      <p>Get a free Digital Audit — see your Google ranking, reviews, and website speed compared to your top local competitors.</p>\n      <a href=\"/get-started/\" class=\"cta-btn\">Get My Free Digital Audit</a>\n    </div>\n    <h2>Frequently asked questions</h2>\n    <div class=\"qa-box\">\n      <h3>How many Google reviews do I need to rank in the map pack?</h3>\n      <p>There’s no exact threshold, but top-three local results average around 47 reviews while positions 7–10 average about 38. Aim to clear roughly 50 to compete and 100+ to be hard to displace — paired with a steady, recent flow rather than a one-time push.</p>\n    </div>\n    <div class=\"qa-box\">\n      <h3>Do older Google reviews still count?</h3>\n      <p>They count, but far less than recent ones. Google weights fresh reviews more heavily because they signal an active, currently-trusted business. A steady stream of new reviews typically outperforms a larger but stale review base.</p>\n    </div>\n    <div class=\"qa-box\">\n      <h3>How do I get more Google reviews as a contractor?</h3>\n      <p>Use a system, not memory. Send an automated text or email with a direct review link after every completed job, prompt customers to mention the specific work and town, and respond to every review. Automated requests dramatically out-perform asking manually, which always fades over time.</p>\n    </div>\n    <div class=\"qa-box\">\n      <h3>Does my star rating matter as much as the number of reviews?</h3>\n      <p>Both matter. Volume and recency drive ranking, while your rating and the content of reviews drive whether searchers actually choose you — 97% read reviews before picking a local business. A high count with a mediocre rating still loses jobs to a better-rated competitor.</p>\n    </div>\n<div class=\"related\">\n      <h3>Related articles</h3>\n      <a href=\"/blog/how-to-get-more-google-reviews-local-business/\">How to get more Google reviews for a local business</a>\n      <a href=\"/blog/google-business-profile-optimization-guide/\">Google Business Profile optimization: the complete guide</a>\n      <a href=\"/blog/local-seo-checklist-small-business-2026/\">The local SEO checklist for 2026</a>\n      <a href=\"/blog/why-is-my-contractor-business-not-showing-up-on-google/\">Why isn’t my business showing up on Google?</a>\n      <a href=\"/blog/missed-calls-costing-local-business-money/\">What missed calls are really costing your business</a>\n    </div>\n  </article>\n</main>\n<footer class=\"sl-footer\">\n  <div class=\"wrap\">\n    <div class=\"ft-top\">\n      <div class=\"ft-brand\">\n        <a href=\"/\" class=\"sl-logo\"><span class=\"lg-scale\">Scale</span><span class=\"lg-local\">Local</span></a>\n        <p>SEO web design and AI growth systems for local service businesses.</p>\n      </div>\n      <div class=\"ft-col\">\n        <h4>The Climb</h4>\n        <a href=\"/basecamp/\">Basecamp &mdash; $249/mo</a>\n        <a href=\"/ascent/\">Ascent &mdash; $597/mo</a>\n        <a href=\"/summit/\">Summit &mdash; $997/mo</a>\n        <a href=\"/apex/\">Apex &mdash; $1,497/mo</a>\n      </div>\n      <div class=\"ft-col\">\n        <h4>Company</h4>\n        <a href=\"/about/\">About</a>\n        <a href=\"/pricing/\">Pricing</a>\n        <a href=\"tel:+19786627580\">978.662.7580</a>\n        <a href=\"mailto:hello@scalelocal.net\">hello@scalelocal.net</a>\n      </div>\n    </div>\n    <div class=\"ft-bottom\">&copy; ScaleLocal&trade; &middot; Tewksbury, MA &middot; Serving Massachusetts, New Hampshire &amp; Rhode Island</div>\n  </div>\n</footer>\n</body>\n</html>\n"}