{
  "rewrites": [
    {
      "source": "/sniper",
      "destination": "/sniper.html"
    },
    {
      "source": "/sniper/api/:path*",
      "destination": "https://bdpp-api.onrender.com/api/:path*"
    },
    {
      "source": "/(test-builds|Test-Builds|TEST-BUILDS|test-Builds|Test-builds)/(tnj-landscape|TNJ-Landscape|TNJ-LANDSCAPE|tnj-Landscape|Tnj-Landscape|tnj-landscape)/(.*)",
      "destination": "/test-builds/tnj-landscape/$3"
    },
    {
      "source": "/(test-builds|Test-Builds|TEST-BUILDS|test-Builds|Test-builds)/(tnj-landscape|TNJ-Landscape|TNJ-LANDSCAPE|tnj-Landscape|Tnj-Landscape|tnj-landscape)",
      "destination": "/test-builds/tnj-landscape/index.html"
    },
    {
      "source": "/(test-builds|Test-Builds|TEST-BUILDS|test-Builds|Test-builds)/(fitzgerald-gc|Fitzgerald-GC|FITZGERALD-GC|fitzgerald-GC|Fitzgerald-gc|Fitzgerald-Gc)/(.*)",
      "destination": "/test-builds/fitzgerald-gc/$3"
    },
    {
      "source": "/(test-builds|Test-Builds|TEST-BUILDS|test-Builds|Test-builds)/(fitzgerald-gc|Fitzgerald-GC|FITZGERALD-GC|fitzgerald-GC|Fitzgerald-gc|Fitzgerald-Gc)",
      "destination": "/test-builds/fitzgerald-gc/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/chat-agent/:slug([a-zA-Z0-9][a-zA-Z0-9-]*)",
      "destination": "/chat-agent/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/test-builds/tnj-landscape",
      "destination": "/test-builds/tnj-landscape/",
      "permanent": true
    },
    {
      "source": "/(test-builds|Test-Builds|TEST-BUILDS|test-Builds|Test-builds)/(tnj-landscape|TNJ-Landscape|TNJ-LANDSCAPE|tnj-Landscape|Tnj-Landscape)",
      "destination": "/test-builds/tnj-landscape/",
      "permanent": true
    },
    {
      "source": "/test-builds/fitzgerald-gc",
      "destination": "/test-builds/fitzgerald-gc/",
      "permanent": true
    },
    {
      "source": "/(test-builds|Test-Builds|TEST-BUILDS|test-Builds|Test-builds)/(Fitzgerald-GC|FITZGERALD-GC|fitzgerald-GC|Fitzgerald-gc|Fitzgerald-Gc)",
      "destination": "/test-builds/fitzgerald-gc/",
      "permanent": true
    },
    {
      "source": "/menu",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/quiz",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/quiz/(.*)",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/snapshot",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/snapshot/(.*)",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/start",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/grow",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/free-website",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/recommendation",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/audit",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/audit/(.*)",
      "destination": "/get-started",
      "permanent": true
    },
    {
      "source": "/websites",
      "destination": "/web-solutions",
      "permanent": true
    },
    {
      "source": "/receptionist",
      "destination": "/ai-solutions",
      "permanent": true
    },
    {
      "source": "/plans/foundation",
      "destination": "/basecamp",
      "permanent": true
    },
    {
      "source": "/plans/foundation/",
      "destination": "/basecamp/",
      "permanent": true
    },
    {
      "source": "/plans/momentum",
      "destination": "/summit",
      "permanent": true
    },
    {
      "source": "/plans/momentum/",
      "destination": "/summit/",
      "permanent": true
    },
    {
      "source": "/plans/authority",
      "destination": "/apex",
      "permanent": true
    },
    {
      "source": "/plans/authority/",
      "destination": "/apex/",
      "permanent": true
    },
    {
      "source": "/plans",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/reactivation",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sniper.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "scalelocal.net"
        }
      ],
      "destination": "https://www.scalelocal.net/$1",
      "permanent": true
    },
    {
      "source": "/test-builds/lawnwize",
      "destination": "/test-builds/lawnwize/",
      "permanent": true
    },
    {
      "source": "/(Test-builds|Test-Builds|TEST-BUILDS|test-Builds|TEST-builds)/(lawnwize|LawnWize|Lawnwize|LAWNWIZE|lawnWize)",
      "destination": "/test-builds/lawnwize/",
      "permanent": true
    },
    {
      "source": "/(Test-builds|Test-Builds|TEST-BUILDS|test-Builds|TEST-builds)/(lawnwize|LawnWize|Lawnwize|LAWNWIZE|lawnWize)/",
      "destination": "/test-builds/lawnwize/",
      "permanent": true
    },
    {
      "source": "/test-builds/(LawnWize|Lawnwize|LAWNWIZE|lawnWize)",
      "destination": "/test-builds/lawnwize/",
      "permanent": true
    },
    {
      "source": "/test-builds/(LawnWize|Lawnwize|LAWNWIZE|lawnWize)/",
      "destination": "/test-builds/lawnwize/",
      "permanent": true
    },
    {
      "source": "/test-builds/ns-builders",
      "destination": "/test-builds/ns-builders/",
      "permanent": true
    },
    {
      "source": "/(test-builds|Test-Builds|TEST-BUILDS|test-Builds|Test-builds)/(NS-Builders|NS-BUILDERS|Ns-Builders|ns-Builders|Ns-builders)",
      "destination": "/test-builds/ns-builders/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/test-builds/ns-builders/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}