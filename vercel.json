{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/chat-agent/:slug([a-zA-Z0-9][a-zA-Z0-9-]*)", "destination": "/chat-agent/index.html" }
  ],
  "redirects": [
    { "source": "/menu", "destination": "/pricing", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "scalelocal.net" }], "destination": "https://www.scalelocal.net/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
